<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/red_black_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:text="Red or Black"
            android:textColor="@color/bluedark"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/penalty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="Penalty: 5 drinks"
            android:textColor="@color/bluedark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/round_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="Round 1 of 5"
            android:textColor="@color/bluedark"
            android:textSize="18sp"
            android:alpha="0.7" />

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="210dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/duel_card_back" />

            <TextView
                android:id="@+id/card_value_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/viga"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/choice_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_red"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/gambler_btn_red"
                android:fontFamily="@font/viga"
                android:text="Red"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="22sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_black"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/gambler_btn_black"
                android:fontFamily="@font/viga"
                android:text="Black"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="22sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/result_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:paddingTop="10dp"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_finish"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/viga"
            android:background="@drawable/outlineforbutton"
            android:text="FINISH"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone"
            app:backgroundTint="@null" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
