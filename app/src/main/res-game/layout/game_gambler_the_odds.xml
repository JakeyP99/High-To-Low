<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/viga"
        android:text="Higher or Lower"
        android:textColor="@color/bluedark"
        android:textSize="30sp" />

    <!-- Step 1: Number Selection (3-8) -->
    <LinearLayout
        android:id="@+id/selection_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/viga"
            android:text="Select your Starting Card"
            android:textColor="@color/bluedark"
            android:textSize="18sp" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2">

            <Button
                android:id="@+id/btn_3"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="3"
                android:textColor="@color/bluedark"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_4"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="4"
                android:textColor="@color/bluedark"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_5"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="5"
                android:textColor="@color/bluedark"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_6"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="6"
                android:textColor="@color/bluedark"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_7"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="7"
                android:textColor="@color/bluedark"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_8"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="8"
                android:textColor="@color/bluedark"
                android:textSize="20sp" />
        </GridLayout>
    </LinearLayout>

    <!-- Step 2: Duel Area -->
    <LinearLayout
        android:id="@+id/duel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Gambler's Choice -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/outlineforbutton"
                android:padding="8dp">

                <TextView
                    android:id="@+id/gambler_card_val"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/viga"
                    android:gravity="center"
                    android:text="X"
                    android:textColor="@color/bluedark"
                    android:textSize="60sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="@font/viga"
                android:text="VS"
                android:textColor="@color/bluedark"
                android:textSize="24sp" />

            <!-- Opponent's Card -->
            <FrameLayout
                android:id="@+id/opponent_card_container"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/duel_card_back">

                <TextView
                    android:id="@+id/opponent_card_val"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/viga"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/bluedark"
                    android:textSize="60sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/opponent_card_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/bet_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/viga"
            android:text="Predict the Opponent's Card"
            android:textColor="@color/bluedark"
            android:textSize="18sp" />

        <!-- Choice Buttons -->
        <LinearLayout
            android:id="@+id/choice_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_higher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="55dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="Higher"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_equal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="55dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="Equal"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_lower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="55dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="Lower"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/game_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/viga"
            android:textAlignment="center"
            android:textColor="@color/bluedark"
            android:textSize="22sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btn_finish"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="Finish"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
