<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/white"
    android:layout_margin="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:text="Wildcard!"
            android:textAlignment="center"
            android:textColor="@color/bluedark"
            android:textSize="35sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view_separator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:alpha="0.2"
            android:background="@color/bluedark"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <TextView
            android:id="@+id/textView_WildText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:text="Loading..."
            android:textAlignment="center"
            android:textColor="@color/bluedark"
            android:textSize="22sp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/barrier_buttons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_separator"
            app:layout_constraintVertical_bias="0.5" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="btnQuizAnswerTL,btnQuizAnswerTR,btnQuizAnswerBL,btnQuizAnswerBR,btnAnswer,btnBackWildCard" />

        <!-- MCQ Buttons Container (Top Row) -->
        <Button
            android:id="@+id/btnQuizAnswerTL"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:textAllCaps="false"
            android:padding="10sp"
            android:textColor="@color/bluedark"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnQuizAnswerBL"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnQuizAnswerTR"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:textAllCaps="false"
            android:padding="10sp"
            android:textColor="@color/bluedark"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnQuizAnswerBR"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineCenter" />

        <!-- MCQ Buttons Container (Bottom Row) -->
        <Button
            android:id="@+id/btnQuizAnswerBL"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:textAllCaps="false"
            android:padding="10sp"
            android:textColor="@color/bluedark"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnBackWildCard"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnQuizAnswerBR"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="15dp"
            android:padding="10sp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnBackWildCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineCenter" />

        <!-- TF Answer Button -->
        <Button
            android:id="@+id/btnAnswer"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="@string/Answer"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnBackWildCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Continue Button -->
        <Button
            android:id="@+id/btnBackWildCard"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="@string/continueTxt"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Confetti Gif overlays -->
        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewTL"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerTL"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerTL"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerTL"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerTL" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewTR"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerTR"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerTR"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerTR"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerTR" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewBL"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerBL"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerBL"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerBL"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerBL" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewBR"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerBR"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerBR"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerBR"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerBR" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
