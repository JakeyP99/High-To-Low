<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/rounded_background"
    android:gravity="center">

    <TextView
        android:id="@+id/duel_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="High Card Duel"
        android:textColor="@color/bluedark"
        android:textSize="30sp"
        android:layout_marginBottom="24dp"/>

    <!-- Gambler's Card -->
    <FrameLayout
        android:id="@+id/gambler_card_container"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:background="@drawable/duel_card_back"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <TextView
            android:id="@+id/gambler_card_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:fontFamily="@font/viga"
            android:textColor="@color/bluedark"
            android:textSize="30sp"
            android:text="Gambler" />

        <ImageView
            android:id="@+id/gambler_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="VS"
        android:textColor="@color/bluedark"
        android:textSize="25sp"
        android:layout_marginVertical="16dp"/>

    <!-- Opponent's Card -->
    <FrameLayout
        android:id="@+id/opponent_card_container"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:background="@drawable/duel_card_back"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <TextView
            android:id="@+id/opponent_card_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:fontFamily="@font/viga"
            android:textColor="@color/bluedark"
            android:textSize="30sp"
            android:text="Opponent" />

        <ImageView
            android:id="@+id/opponent_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/duel_result_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:textColor="@color/bluedark"
        android:textSize="25sp"
        android:layout_marginTop="24dp"
        android:textAlignment="center"
        android:visibility="invisible"/>

    <Button
        android:id="@+id/btn_finish_duel"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:fontFamily="@font/viga"
        android:background="@drawable/outlineforbutton"
        android:text="Finish"
        android:textAllCaps="false"
        android:textColor="@color/bluedark"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:visibility="gone"/>

</LinearLayout>
