<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/powerup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Power Up"
            android:textColor="@color/bluedark"
            android:textSize="35sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:alpha="0.2"
            android:background="@color/bluedark" />

        <TextView
            android:id="@+id/powerup_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:text="Description of the powerup goes here."
            android:textColor="@color/bluedark"
            android:textSize="25sp" />


        <Button
            android:id="@+id/btn_activate_powerup"
            android:layout_width="220dp"
            android:layout_height="70dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/viga"
            android:background="@drawable/outlineforbutton"
            android:text="Activate"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_cancel_powerup"
            android:layout_width="220dp"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/viga"
            android:background="@drawable/outlineforbutton"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:padding="12dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
