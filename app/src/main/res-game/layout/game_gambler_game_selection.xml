<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/viga"
        android:paddingTop="10dp"
        android:text="Choose Your Game"
        android:textAlignment="center"
        android:textColor="@color/bluedark"
        android:textSize="32sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:alpha="0.1"
        android:background="@color/bluedark" />

    <!-- Game 1: High Card Duel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_high_card"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/outlineforbutton"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iconHighCard"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/cards"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textHighCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/viga"
            android:text="High Card Duel"
            android:textColor="@color/bluedark"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subHighCard"
            app:layout_constraintEnd_toStartOf="@id/arrowHighCard"
            app:layout_constraintStart_toEndOf="@id/iconHighCard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subHighCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:fontFamily="@font/viga"
            android:text="Gambler's Card vs Opponents"
            android:textColor="@color/bluedark"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textHighCard"
            app:layout_constraintStart_toStartOf="@id/textHighCard"
            app:layout_constraintTop_toBottomOf="@id/textHighCard" />

        <ImageView
            android:id="@+id/arrowHighCard"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:alpha="0.3"
            android:src="@drawable/arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Game 2: Red or Black -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_red_black"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/outlineforbutton"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/iconRedBlack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/redcard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textRedBlack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/viga"
            android:text="Red or Black"
            android:textColor="@color/bluedark"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subRedBlack"
            app:layout_constraintEnd_toStartOf="@id/arrowRedBlack"
            app:layout_constraintStart_toEndOf="@id/iconRedBlack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subRedBlack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:fontFamily="@font/viga"
            android:text="Drink if you guess wrong"
            android:textColor="@color/bluedark"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textRedBlack"
            app:layout_constraintStart_toStartOf="@id/textRedBlack"
            app:layout_constraintTop_toBottomOf="@id/textRedBlack" />

        <ImageView
            android:id="@+id/arrowRedBlack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:alpha="0.3"
            android:src="@drawable/arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
