<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="450dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/quiz_streak_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Streak: 1"
            android:textColor="@color/bluedark"
            android:textSize="35sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:alpha="0.2"
            android:background="@color/bluedark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/viga"
            android:text="Continue and risk losing your streak, or hand out the drinks now?"
            android:textAlignment="center"
            android:textColor="@color/bluedark"
            android:textSize="25sp" />

        <Button
            android:id="@+id/btn_continue_streak"
            android:layout_width="240dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="Continue Streak"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp" />

        
        <Button
            android:id="@+id/btn_stop_streak"
            android:layout_width="240dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="Give Drinks"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
