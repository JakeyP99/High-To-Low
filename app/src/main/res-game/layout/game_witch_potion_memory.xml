<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/rounded_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:layout_gravity="center"
        android:paddingTop="10dp"
        android:text="Witch's Active!"
        android:textAlignment="center"
        android:textColor="@color/bluedark"
        android:textSize="45sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/bluedark"
        android:alpha="0.2" />

    <TextView
        android:id="@+id/memory_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:paddingTop="10dp"
        android:text="Watch carefully!"
        android:textColor="@color/bluedark"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:padding="8dp">

        <View
            android:id="@+id/btn_red"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#FF4444"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_blue"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#4444FF"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_green"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#44FF44"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_yellow"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#FFFF44"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

    </GridLayout>

    <TextView
        android:id="@+id/memory_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/viga"
        android:text="Score: 0"
        android:textColor="@color/bluedark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/outlineforbutton"
        android:fontFamily="@font/viga"
        android:text="Start Game"
        android:textAllCaps="false"
        android:textColor="@color/bluedark"
        android:textSize="20sp" />

</LinearLayout>
