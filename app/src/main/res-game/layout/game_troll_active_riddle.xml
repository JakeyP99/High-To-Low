<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:layout_gravity="center"
        android:paddingTop="10dp"
        android:text="Troll's Active!"
        android:textAlignment="center"
        android:textColor="@color/bluedark"
        android:textSize="30sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="10dp"
        android:background="@color/bluedark"
        android:alpha="0.2" />

    <!-- Step 1: The Riddle -->
    <LinearLayout
        android:id="@+id/step1_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/troll_targets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:text="This riddle is for: Jakey Jake"
            android:textColor="@color/bluedark"
            android:textSize="25sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F5F5F5">

            <TextView
                android:id="@+id/troll_riddle_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:fontFamily="@font/viga"
                android:gravity="center"
                android:text="Riddle goes here..."
                android:textColor="@color/bluedark"
                android:textSize="20sp" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_reveal_answer"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="Answer"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Step 2: Result -->
    <LinearLayout
        android:id="@+id/step2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F5F5F5">

            <TextView
                android:id="@+id/troll_answer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:fontFamily="@font/viga"
                android:gravity="center"
                android:text="ANSWER"
                android:textColor="@color/bluedark"
                android:textSize="25sp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/viga"
            android:text="Who got it right first?"
            android:textColor="@color/bluedark"
            android:textSize="25sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_player1_correct"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:scrollHorizontally="true"
                android:padding="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="P1"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="25sp" />

            <Button
                android:id="@+id/btn_player2_correct"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:scrollHorizontally="true"
                android:padding="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:background="@drawable/outlineforbutton"
                android:fontFamily="@font/viga"
                android:text="P2"
                android:textAllCaps="false"
                android:textColor="@color/bluedark"
                android:textSize="25sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_both_wrong"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="No one"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="25sp" />
    </LinearLayout>

</LinearLayout>
