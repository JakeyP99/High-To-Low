<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <!-- Mute/Sound Icons -->
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/soundGif"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/sound"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp" />

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/muteGif"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/mute"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp" />

    <!-- Title Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/arrowUp"
            android:layout_width="30dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_title_arrow_up"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@id/titleHigh"
            app:layout_constraintEnd_toStartOf="@id/titleHigh"
            app:layout_constraintTop_toTopOf="@id/titleHigh" />

        <TextView
            android:id="@+id/titleHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIGH"
            android:textColor="@color/bluedark"
            android:textSize="55sp"
            android:fontFamily="@font/viga"
            android:textStyle="bold"
            android:rotation="-2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/titleTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TO"
            android:textColor="@color/bluedark"
            android:textSize="25sp"
            android:fontFamily="@font/viga"
            app:layout_constraintTop_toBottomOf="@id/titleHigh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-10dp" />

        <TextView
            android:id="@+id/titleLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOW"
            android:textColor="@color/bluedark"
            android:textSize="55sp"
            android:fontFamily="@font/viga"
            android:textStyle="bold"
            android:rotation="-2"
            app:layout_constraintTop_toBottomOf="@id/titleTo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-10dp" />

        <ImageView
            android:id="@+id/arrowDown"
            android:layout_width="30dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_title_arrow_down"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/titleLow"
            app:layout_constraintBottom_toBottomOf="@id/titleLow"
            app:layout_constraintStart_toEndOf="@id/titleLow" />

        <TextView
            android:id="@+id/slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— Ready for some drinking? —"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:fontFamily="@font/viga"
            app:layout_constraintTop_toBottomOf="@id/titleLow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/drinkGif"
        android:layout_width="180dp"
        android:layout_height="220dp"
        android:background="@android:color/transparent"
        android:src="@drawable/shots"
        app:layout_constraintBottom_toTopOf="@+id/quickplay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleLayout"
        app:layout_constraintVertical_bias="0.49" />

    <!-- Play Classic Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quickplay"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/outlineforbutton"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/drinkGif"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/iconClassic"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/tequila"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textClassic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/viga"
            android:text="Play Classic"
            android:textColor="@color/bluedark"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subClassic"
            app:layout_constraintStart_toEndOf="@id/iconClassic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subClassic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:text="Don't land on zero!"
            android:textColor="@color/bluedark"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/textClassic"
            app:layout_constraintTop_toBottomOf="@id/textClassic" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Roulette Mode Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playCards"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/outlineforbutton"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quickplay"
        app:layout_constraintVertical_bias="0.20">

        <ImageView
            android:id="@+id/iconRoulette"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/gunicon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textRoulette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/viga"
            android:text="Roulette Mode"
            android:textColor="@color/bluedark"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subRoulette"
            app:layout_constraintStart_toEndOf="@id/iconRoulette"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subRoulette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:text="Russian roulette style!"
            android:textColor="@color/bluedark"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRoulette"
            app:layout_constraintTop_toBottomOf="@id/textRoulette" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Buttons -->
    <Button
        android:id="@+id/button_Instructions"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/outlineforbutton"
        android:fontFamily="@font/viga"
        android:text="Instructions"
        android:textAllCaps="false"
        android:textColor="@color/bluedark"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_Statistics"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playCards" />

    <Button
        android:id="@+id/button_Statistics"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/outlineforbutton"
        android:fontFamily="@font/viga"
        android:text="Statistics"
        android:textAllCaps="false"
        android:textColor="@color/bluedark"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/button_Instructions"
        app:layout_constraintTop_toBottomOf="@+id/playCards" />

</androidx.constraintlayout.widget.ConstraintLayout>
