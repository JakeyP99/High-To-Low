<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/white"
    android:layout_margin="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="24dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/viga"
            android:paddingTop="10dp"
            android:text="Quiz!"
            android:textAlignment="center"
            android:textColor="@color/bluedark"
            android:textSize="45sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:alpha="0.2"
            android:background="@color/bluedark"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView"
            app:layout_constraintTop_toTopOf="@+id/textView_WildText"
            tools:layout_editor_absoluteX="44dp" />

        <TextView
            android:id="@+id/textView_WildText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/viga"
            android:gravity="center"
            android:minHeight="150dp"
            android:text="Quiz! Who is the current Prime Minister of Japan?"
            android:textAlignment="center"
            android:textColor="@color/bluedark"
            android:textSize="22sp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view" />

        <Button
            android:id="@+id/btnAnswer"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="@string/Answer"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView_WildText" />

        <Button
            android:id="@+id/btnQuizAnswerTL"
            android:layout_width="150dp"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:padding="8dp"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="18sp"
            android:visibility="visible"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintTop_toBottomOf="@+id/textView_WildText" />

        <Button
            android:id="@+id/btnQuizAnswerTR"
            android:layout_width="150dp"
            android:layout_height="90dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/outlineforbutton"
            android:ellipsize="end"
            android:fontFamily="@font/viga"
            android:maxLines="2"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="18sp"
            android:visibility="visible"
            app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
            app:layout_constraintTop_toBottomOf="@+id/textView_WildText" />

        <Button
            android:id="@+id/btnQuizAnswerBL"
            android:layout_width="150dp"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:padding="8dp"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="18sp"
            android:visibility="visible"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintTop_toBottomOf="@+id/btnQuizAnswerTL" />

        <Button
            android:id="@+id/btnQuizAnswerBR"
            android:layout_width="150dp"
            android:layout_height="90dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="It established the principle of the rule of law"
            android:padding="8dp"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="18sp"
            android:visibility="visible"
            app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
            app:layout_constraintTop_toBottomOf="@+id/btnQuizAnswerTR" />

        <Button
            android:id="@+id/btnBackWildCard"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/outlineforbutton"
            android:fontFamily="@font/viga"
            android:text="@string/continueTxt"
            android:textAllCaps="false"
            android:textColor="@color/bluedark"
            android:textSize="20sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnQuizAnswerBL" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewTL"
            android:layout_width="140dp"
            android:layout_height="80dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerTL"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerTL"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerTL"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerTL" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewTR"
            android:layout_width="140dp"
            android:layout_height="80dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerTR"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerTR"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerTR"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerTR" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewBL"
            android:layout_width="140dp"
            android:layout_height="80dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerBL"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerBL"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerBL"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerBL" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/confettiImageViewBR"
            android:layout_width="140dp"
            android:layout_height="80dp"
            android:src="@drawable/confetti"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/btnQuizAnswerBR"
            app:layout_constraintEnd_toEndOf="@id/btnQuizAnswerBR"
            app:layout_constraintStart_toStartOf="@id/btnQuizAnswerBR"
            app:layout_constraintTop_toTopOf="@id/btnQuizAnswerBR" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
