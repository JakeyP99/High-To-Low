<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/rounded_background">

    <TextView
        android:id="@+id/memory_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="Alchemist's Memory"
        android:textColor="@color/bluedark"
        android:textSize="28sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/memory_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="Watch carefully!"
        android:textColor="@color/bluedark"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:padding="8dp">

        <View
            android:id="@+id/btn_red"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#FF4444"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_blue"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#4444FF"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_green"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#44FF44"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_yellow"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:background="#FFFF44"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true" />

    </GridLayout>

    <TextView
        android:id="@+id/memory_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/viga"
        android:text="Score: 0"
        android:textColor="@color/bluedark"
        android:textSize="24sp" />

</LinearLayout>
