<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/rounded_background">

    <TextView
        android:id="@+id/witch_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="Witch's Potion"
        android:textColor="@color/bluedark"
        android:textSize="28sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/math_problem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="653 x 593"
        android:textColor="@color/bluedark"
        android:textSize="36sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/viga"
        android:text="15s"
        android:textColor="#FF0000"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/math_answer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/outlineforbutton"
        android:fontFamily="@font/viga"
        android:hint="Enter answer..."
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textColor="@color/bluedark"
        android:gravity="center"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn_submit_potion"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/outlineforbutton"
        android:fontFamily="@font/viga"
        android:text="THROW POTION"
        android:textAllCaps="false"
        android:textColor="@color/bluedark"
        android:textSize="18sp" />

</LinearLayout>
