<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/viga"
        android:paddingTop="10dp"
        android:text="Choose Mode"
        android:textAlignment="center"
        android:textColor="@color/bluedark"
        android:textSize="35sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:alpha="0.1"
        android:background="@color/bluedark" />

    <!-- Mode 1: Classic -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_mode_classic"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/outlineforbutton"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iconClassic"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/selection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textClassic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/viga"
            android:text="Standard Mode"
            android:textColor="@color/bluedark"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subClassic"
            app:layout_constraintEnd_toStartOf="@id/arrowClassic"
            app:layout_constraintStart_toEndOf="@id/iconClassic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subClassic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:fontFamily="@font/viga"
            android:text="Everyone picks a class"
            android:textColor="@color/bluedark"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textClassic"
            app:layout_constraintStart_toStartOf="@id/textClassic"
            app:layout_constraintTop_toBottomOf="@id/textClassic" />

        <ImageView
            android:id="@+id/arrowClassic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:alpha="0.3"
            android:src="@drawable/arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mode 2: Class Hunt -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_mode_class_hunt"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/outlineforbutton"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iconHunt"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/target"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textHunt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/viga"
            android:text="Class Hunt"
            android:textColor="@color/bluedark"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subHunt"
            app:layout_constraintEnd_toStartOf="@id/arrowHunt"
            app:layout_constraintStart_toEndOf="@id/iconHunt"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subHunt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:fontFamily="@font/viga"
            android:text="Unlock classes randomly"
            android:textColor="@color/bluedark"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textHunt"
            app:layout_constraintStart_toStartOf="@id/textHunt"
            app:layout_constraintTop_toBottomOf="@id/textHunt" />

        <ImageView
            android:id="@+id/arrowHunt"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:alpha="0.3"
            android:src="@drawable/arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
