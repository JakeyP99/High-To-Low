<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/deletePlayerImageView"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/delete"
        android:contentDescription="TODO" />

    <ImageView
        android:id="@+id/playerPhotoImageView"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:scaleType="centerCrop"
        android:layout_below="@id/deletePlayerImageView"
        android:src="@drawable/wine"
        android:layout_marginTop="-10dp"
        android:contentDescription="TODO" />

    <TextView
        android:id="@+id/playerNameTextView"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/playerPhotoImageView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:text="Jakey Jake"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/viga"
        android:textColor="@color/bluedark"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/playerClassTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/playerNameTextView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="15dp"
        android:maxWidth="90dp"
        android:maxLines="1"
        android:lines="1"
        android:ellipsize="end"
        android:fontFamily="@font/viga"
        android:text="Quiz Magician"
        android:textColor="#888888"
        android:textSize="14sp" />


</RelativeLayout>
